{
  "name": "playwright-orangehrm-automation",
  "version": "1.0.0",
  "description": "Playwright Test Automation Framework for OrangeHRM",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:safari": "playwright test --project=webkit",
    "test:all-browsers": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:login": "playwright test tests/login.spec.ts",
    "test:employee": "playwright test tests/employee.spec.ts",
    "report": "playwright show-report",
    "report:html": "playwright show-report playwright-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "install:browsers": "playwright install"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "orangehrm",
    "e2e"
  ],
  "author": "Obulesu G",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "allure-playwright": "^2.15.0",
    "dotenv": "^16.3.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "faker": "^5.5.3"
  }
}
